cc_library {
    name: "libaudioclient_shim",
    srcs: ["shim.cc"],
    defaults: ["latest_android_media_audio_common_types_cpp_shared"],
    shared_libs: [
        "audioclient-types-aidl-cpp",
        "libaudioclient",
        "libaudioclient_aidl_conversion",
        "libaudiofoundation",
        "libaudiopolicy",
        "liblog",
        "libutils",
    ],
    header_libs: [
        "libaudio_system_headers",
    ],
    system_ext_specific: true,
}
